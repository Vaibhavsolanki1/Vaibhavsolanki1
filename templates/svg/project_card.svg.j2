<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 {{ height | default(380) }}" width="800" height="{{ height | default(380) }}" fill="none">
  {{ system_styles | safe }}

  <defs>
    <pattern id="questHalftone" x="0" y="0" width="8" height="8" patternUnits="userSpaceOnUse">
      <circle cx="4" cy="4" r="1" fill="#E94560" fill-opacity="0.08"/>
    </pattern>
  </defs>

  <!-- Manga Panel Outer Border & Background -->
  <rect width="100%" height="100%" rx="6" fill="var(--bg-canvas)" stroke="var(--border-muted)" stroke-width="2"/>
  <rect x="4" y="4" width="792" height="{{ height - 8 }}" rx="4" fill="var(--bg-surface)" stroke="var(--border-muted)" stroke-width="1"/>
  <rect x="4" y="4" width="792" height="{{ height - 8 }}" fill="url(#questHalftone)"/>

  <!-- Panel Header -->
  <g transform="translate(24, 28)">
    <text x="0" y="0" fill="var(--text-primary)" font-family="var(--font-manga-title)" font-size="20" font-weight="900" letter-spacing="1.5px">📜 ACTIVE QUEST BOARD // FEATURED PROJECTS</text>
    <line x1="0" y1="14" x2="752" y2="14" stroke="var(--border-muted)" stroke-width="1.5"/>
  </g>

  <!-- Quest Scroll Cards -->
  <g transform="translate(24, 60)">
    {% for proj in projects %}
    {% set y_offset = loop.index0 * 105 %}
    <g transform="translate(0, {{ y_offset }})">
      <!-- Quest Card Background -->
      <rect width="752" height="92" rx="6" fill="var(--bg-subtle)" stroke="var(--border-muted)" stroke-width="1.5"/>

      <!-- Quest Number Badge -->
      <g transform="translate(14, 12)">
        <rect width="84" height="20" rx="3" fill="var(--bg-canvas)" stroke="var(--border-muted)" stroke-width="1"/>
        <text x="42" y="14" fill="var(--accent-primary)" font-family="var(--font-manga-body)" font-size="10" font-weight="700" text-anchor="middle">QUEST #0{{ loop.index }}</text>
      </g>

      <!-- Project Name -->
      <text x="108" y="28" fill="var(--text-primary)" font-family="var(--font-manga-title)" font-size="18" font-weight="900" letter-spacing="1px">{{ proj.name }}</text>

      <!-- Status Badge -->
      <rect x="616" y="12" width="122" height="22" rx="4" fill="var(--accent-subtle)" stroke="var(--accent-primary)" stroke-width="1"/>
      <text x="677" y="27" fill="var(--accent-primary)" font-family="var(--font-manga-body)" font-size="10" font-weight="700" text-anchor="middle">⚔️ {{ proj.status | upper }}</text>

      <!-- Description -->
      <text x="16" y="54" fill="var(--text-secondary)" font-family="var(--font-family)" font-size="12">{{ proj.description }}</text>

      <!-- Tech Stack Badges -->
      <g transform="translate(16, 68)">
        {% for t in proj.tech %}
        <text x="{{ loop.index0 * 85 }}" y="12" fill="var(--accent-hover)" font-family="var(--font-family)" font-size="10" font-weight="600">#{{ t }}</text>
        {% endfor %}
      </g>
      
      <!-- Difficulty Stars -->
      <text x="738" y="78" fill="var(--status-warning)" font-family="var(--font-family)" font-size="12" text-anchor="end">{{ proj.difficulty | default("★★★★★") }}</text>
    </g>
    {% endfor %}
  </g>
</svg>

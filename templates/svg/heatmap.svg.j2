<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 160" width="800" height="160" fill="none">
  {{ system_styles | safe }}
  
  <rect width="100%" height="100%" rx="8" fill="var(--bg-surface)" stroke="var(--border-muted)" stroke-width="1"/>
  
  <text x="24" y="28" fill="var(--text-primary)" font-family="var(--font-family)" font-size="14" font-weight="700">CONTRIBUTION HEATMAP</text>
  <text x="776" y="28" fill="var(--text-secondary)" font-family="var(--font-family)" font-size="12" text-anchor="end">
    {% if stats.total_contributions is string %}
    {{ stats.total_contributions }}
    {% else %}
    {{ stats.total_contributions }} Total Contributions
    {% endif %}
  </text>

  {% if heatmap_rects %}
  <!-- Heatmap Grid Rects -->
  <g transform="translate(0, 10)">
    {{ heatmap_rects | safe }}
  </g>
  {% else %}
  <g transform="translate(400, 85)">
    <text fill="var(--text-muted)" font-family="var(--font-family)" font-size="12" text-anchor="middle">Data unavailable (Authentication required)</text>
  </g>
  {% endif %}
  
  <!-- Heatmap Legend -->
  <g class="heatmap-legend" transform="translate(620, 138)">
    <text x="0" y="10" fill="var(--text-muted)" font-family="var(--font-family)" font-size="10">Less</text>
    <rect x="30" y="2" width="10" height="10" rx="2" fill="var(--contribution-0)"/>
    <rect x="44" y="2" width="10" height="10" rx="2" fill="var(--contribution-1)"/>
    <rect x="58" y="2" width="10" height="10" rx="2" fill="var(--contribution-2)"/>
    <rect x="72" y="2" width="10" height="10" rx="2" fill="var(--contribution-3)"/>
    <rect x="86" y="2" width="10" height="10" rx="2" fill="var(--contribution-4)"/>
    <text x="104" y="10" fill="var(--text-muted)" font-family="var(--font-family)" font-size="10">More</text>
  </g>
</svg>
